#!/usr/bin/env bash
set -euxo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPOSITORY_ROOT="$(dirname -- "$SCRIPT_DIR")"
cd "$REPOSITORY_ROOT"

TEMP_DIR="$(mktemp -d)"

APP_VERSION="$(tr -d '\r\n' < "$REPOSITORY_ROOT/CODEX_DESKTOP_VERSION")"
curl -o "$TEMP_DIR/file.zip" "https://persistent.oaistatic.com/codex-app-prod/ChatGPT-darwin-arm64-$APP_VERSION.zip"

HOSTED_CODEX_APP_ZIP="$TEMP_DIR/file.zip" bash "$SCRIPT_DIR/prepare_asar"

rm -rf "$TEMP_DIR"
