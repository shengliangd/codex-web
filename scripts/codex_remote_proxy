#!/usr/bin/env bash
set -euo pipefail

while [[ "${1:-}" == "-c" ]]; do
  if (( $# < 2 )); then
    echo "codex_remote_proxy received -c without a value" >&2
    exit 64
  fi
  shift 2
done

if [[ "${1:-}" != "app-server" ]]; then
  echo "codex_remote_proxy only supports app-server mode" >&2
  exit 64
fi

# Ignore remaining args (for compatibility with codex app-server invocations).
shift || true

# Keep a generous payload limit for large app-server responses. The Node bridge
# also handles short-lived rollout materialization races before they reach the
# desktop client.
CODEX_BUFFER_SIZE="${CODEX_BUFFER_SIZE:-104857600}"
CODEX_UNIX_SOCKET="${CODEX_UNIX_SOCKET:?CODEX_UNIX_SOCKET must be set}"

exec node "$(dirname "${BASH_SOURCE[0]}")/codex_unix_socket_bridge.cjs"
