#!/usr/bin/env bash
set -euo pipefail

listen_address=""
app_server_socket=""
app_server_socket_explicit=false
configure_only=false

usage() {
  echo "Usage: $0 --listen-address ADDRESS [--socket PATH]" >&2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --listen-address)
      if [[ $# -lt 2 ]]; then
        echo "--listen-address requires an address." >&2
        usage
        exit 2
      fi
      listen_address="$2"
      shift 2
      ;;
    --socket)
      if [[ $# -lt 2 ]]; then
        echo "--socket requires a path." >&2
        usage
        exit 2
      fi
      app_server_socket="$2"
      app_server_socket_explicit=true
      if [[ "${app_server_socket}" != /* ]]; then
        echo "--socket must be an absolute path: ${app_server_socket}" >&2
        exit 2
      fi
      shift 2
      ;;
    --configure-only)
      configure_only=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage
      exit 2
      ;;
  esac
done

if [[ -z "${listen_address}" ]]; then
  echo "--listen-address is required." >&2
  usage
  exit 2
fi

if [[ "${listen_address}" == \[*\] ]]; then
  ipv6_address="${listen_address:1:${#listen_address}-2}"
  if [[ -z "${ipv6_address}" || ! "${ipv6_address}" =~ ^[0-9A-Fa-f:.]+$ ]]; then
    echo "Invalid listen address: ${listen_address}" >&2
    exit 2
  fi
  listen_endpoint="${listen_address}:8443"
elif [[ "${listen_address}" == *:* ]]; then
  if [[ ! "${listen_address}" =~ ^[0-9A-Fa-f:.]+$ ]]; then
    echo "Invalid listen address: ${listen_address}" >&2
    exit 2
  fi
  listen_endpoint="[${listen_address}]:8443"
elif [[ "${listen_address}" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*$ ]]; then
  listen_endpoint="${listen_address}:8443"
else
  echo "Invalid listen address: ${listen_address}" >&2
  exit 2
fi

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repository_root="$(dirname -- "${script_dir}")"

if [[ "${configure_only}" != true ]]; then
  if [[ "${EUID}" -eq 0 ]]; then
    echo "Run this command as the Codex user, without sudo." >&2
    exit 1
  fi

  for command_name in node npm curl unzip patch; do
    if ! command -v "${command_name}" >/dev/null 2>&1; then
      echo "Required command not found: ${command_name}" >&2
      exit 1
    fi
  done

  if [[ -z "${app_server_socket}" ]]; then
    if [[ -n "${CODEX_UNIX_SOCKET:-}" ]]; then
      app_server_socket="${CODEX_UNIX_SOCKET}"
      app_server_socket_explicit=true
    else
      app_server_socket="${CODEX_HOME:-${HOME}/.codex}/app-server-control/app-server-control.sock"
    fi
  fi
  codex_cli="${CODEX_APP_SERVER_CLI:-${CODEX_CLI_PATH:-}}"
  if [[ ! -S "${app_server_socket}" && -z "${codex_cli}" ]] && \
     ! command -v codex >/dev/null 2>&1; then
    echo "Codex CLI not found; install codex or set CODEX_APP_SERVER_CLI." >&2
    exit 1
  fi

  cd "${repository_root}"
  build_stamp="${repository_root}/scratch/.codex-web-build-stamp"
  needs_build=false
  if [[ ! -f src/server/main.js || ! -f scratch/asar/webview/index.html || ! -f "${build_stamp}" ]]; then
    needs_build=true
  elif find \
    CODEX_DESKTOP_VERSION package.json package-lock.json \
    assets patches src/browser src/server \
    scripts/prepare scripts/prepare_asar \
    vite.browser.config.ts \
    -type f -newer "${build_stamp}" -print -quit | grep -q .; then
    needs_build=true
  fi

  if [[ ! -d node_modules ]]; then
    npm ci
    needs_build=false
  elif [[ "${needs_build}" == true ]]; then
    npm run prepare
  fi

  if [[ ! -f src/server/main.js || ! -f scratch/asar/webview/index.html ]]; then
    echo "codex-web build did not produce the required runtime files." >&2
    exit 1
  fi
  if [[ "${needs_build}" == true || ! -f "${build_stamp}" ]]; then
    touch "${build_stamp}"
  fi
  if ! command -v sudo >/dev/null 2>&1; then
    echo "sudo is required to configure Nginx." >&2
    exit 1
  fi

  sudo env CODEX_WEBVIEW_ROOT="${repository_root}/scratch/asar/webview" \
    "${script_dir}/install-https-proxy" --configure-only \
    --listen-address "${listen_address}"

  echo "Starting codex-web in the foreground; press Ctrl-C to stop." >&2
  if [[ "${app_server_socket_explicit}" == true ]]; then
    export CODEX_UNIX_SOCKET="${app_server_socket}"
  else
    unset CODEX_UNIX_SOCKET
  fi
  exec "${script_dir}/start" --host 127.0.0.1 --port 8214
fi

if [[ "${EUID}" -ne 0 ]]; then
  echo "The internal Nginx configuration step must run as root." >&2
  exit 1
fi

webview_source="${CODEX_WEBVIEW_ROOT:-${script_dir}/../scratch/asar/webview}"
if [[ ! -f "${webview_source}/index.html" ]]; then
  echo "Codex webview not found at ${webview_source}" >&2
  exit 1
fi

if ! command -v nginx >/dev/null 2>&1 || \
   ! command -v htpasswd >/dev/null 2>&1 || \
   ! command -v openssl >/dev/null 2>&1 || \
   ! command -v gzip >/dev/null 2>&1; then
  TMPDIR=/var/tmp apt-get update
  TMPDIR=/var/tmp DEBIAN_FRONTEND=noninteractive apt-get install -y \
    nginx apache2-utils openssl gzip
fi

install -d -m 700 /etc/nginx/certs
install -d -m 755 /etc/nginx/auth
install -d -m 755 /srv/codex-web

webview_stage="$(mktemp -d /srv/codex-web/webview.new.XXXXXX)"
trap 'rm -rf -- "${webview_stage}"' EXIT
cp -a "${webview_source}/." "${webview_stage}/"
find "${webview_stage}" -type f \
  \( -name '*.css' -o -name '*.js' -o -name '*.json' -o -name '*.svg' -o -name '*.wasm' \) \
  -size +1024c -exec sh -c '
    for file do
      gzip -c -6 -- "$file" >"${file}.gz.tmp"
      mv -f -- "${file}.gz.tmp" "${file}.gz"
    done
  ' sh {} +
find "${webview_stage}" -type f -name '*.gz' -exec chmod 644 {} +
chmod -R a+rX "${webview_stage}"

if [[ ! -f /etc/nginx/certs/codex-web.crt || ! -f /etc/nginx/certs/codex-web.key ]]; then
  openssl req -x509 -newkey rsa:2048 -sha256 -nodes -days 365 \
    -subj "/CN=$(hostname -f 2>/dev/null || hostname)" \
    -keyout /etc/nginx/certs/codex-web.key \
    -out /etc/nginx/certs/codex-web.crt
  chmod 600 /etc/nginx/certs/codex-web.key
fi

if [[ ! -s /etc/nginx/auth/codex-web ]]; then
  if [[ ! -t 0 ]]; then
    echo "First-time setup needs an interactive terminal for the Basic Auth password." >&2
    exit 1
  fi

  read -r -s -p "Basic Auth password for codex: " password
  printf '\n'
  read -r -s -p "Repeat password: " confirmation
  printf '\n'

  if [[ -z "${password}" || "${password}" != "${confirmation}" ]]; then
    echo "Passwords are empty or do not match." >&2
    exit 1
  fi

  htpasswd -Bci /etc/nginx/auth/codex-web codex <<<"${password}"
  unset password confirmation
fi
chown root:www-data /etc/nginx/auth/codex-web
chmod 640 /etc/nginx/auth/codex-web

trust_token_file=/etc/nginx/auth/codex-web-trust-token
if [[ ! -s "${trust_token_file}" ]]; then
  (umask 077; openssl rand -hex 32 >"${trust_token_file}")
fi
trust_token="$(<"${trust_token_file}")"

cat >/etc/nginx/conf.d/codex-web.conf <<'EOF'
map_hash_bucket_size 128;

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

map $cookie_codex_remember $codex_auth_realm {
    default "Codex Web";
    "__CODEX_TRUST_TOKEN__" off;
}

map $codex_auth_realm $codex_remember_cookie {
    default "codex_remember=__CODEX_TRUST_TOKEN__; Path=/; Max-Age=1209600; Secure; HttpOnly; SameSite=Lax";
    off "";
}

server {
    listen __CODEX_LISTEN_ENDPOINT__ ssl http2;
    send_timeout 300s;
    server_name _;

    ssl_certificate /etc/nginx/certs/codex-web.crt;
    ssl_certificate_key /etc/nginx/certs/codex-web.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:CodexWebSSL:10m;
    ssl_session_timeout 1d;

    auth_basic $codex_auth_realm;
    auth_basic_user_file /etc/nginx/auth/codex-web;

    gzip on;
    gzip_static on;
    gzip_comp_level 6;
    gzip_proxied any;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types application/javascript application/json application/wasm image/svg+xml text/css text/javascript;

    location = /manifest.json {
        auth_basic off;
        root /srv/codex-web/webview;
        expires 1d;
        add_header Cache-Control "public, max-age=86400" always;
    }

    location = /favicon.svg {
        auth_basic off;
        root /srv/codex-web/webview;
        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location = /assets/pwa-icon-512.png {
        auth_basic off;
        alias /srv/codex-web/webview/assets/pwa-icon-512.png;
        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location = /assets/preload.js {
        alias /srv/codex-web/webview/assets/preload.js;
        add_header Cache-Control "no-cache" always;
    }

    # Cached copies of the previous page shell still request this retired
    # sidecar. Serve the inert compatibility shim instead of the SPA fallback.
    location = /eink-theme.js {
        alias /srv/codex-web/webview/eink-theme.js;
        add_header Cache-Control "no-cache" always;
    }

    # These upstream-named bundles are patched locally, so their filenames do
    # not change when their contents do. Always revalidate them after deploys.
    location = /assets/app-initial~app-main~page-BF1QkwFT.js {
        alias /srv/codex-web/webview/assets/app-initial~app-main~page-BF1QkwFT.js;
        add_header Cache-Control "no-cache" always;
    }

    location = /assets/app-initial~app-main~hotkey-window-thread-page~thread-app-shell-chrome~header~remote-conver~h59fr3q5-Cm3GYhJA.js {
        alias /srv/codex-web/webview/assets/app-initial~app-main~hotkey-window-thread-page~thread-app-shell-chrome~header~remote-conver~h59fr3q5-Cm3GYhJA.js;
        add_header Cache-Control "no-cache" always;
    }

    location = /assets/app-initial~app-main~settings-page~appearance-settings~general-settings-DyXXbsyx.js {
        alias /srv/codex-web/webview/assets/app-initial~app-main~settings-page~appearance-settings~general-settings-DyXXbsyx.js;
        add_header Cache-Control "no-cache" always;
    }

    location = /assets/app-initial~app-main~appgen-settings-page~settings-page~skills-settings~plugins-settings~re~n7kg4zj6-CoJ-ih-g.js {
        alias /srv/codex-web/webview/assets/app-initial~app-main~appgen-settings-page~settings-page~skills-settings~plugins-settings~re~n7kg4zj6-CoJ-ih-g.js;
        add_header Cache-Control "no-cache" always;
    }

    location ^~ /assets/ {
        alias /srv/codex-web/webview/assets/;
        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        access_log off;
    }

    location = / {
        root /srv/codex-web/webview;
        try_files /index.html =404;
        add_header Cache-Control "no-cache" always;
        add_header Set-Cookie $codex_remember_cookie;
    }

    location = /index.html {
        root /srv/codex-web/webview;
        add_header Cache-Control "no-cache" always;
        add_header Set-Cookie $codex_remember_cookie;
    }

    location ^~ /__backend/ {
        proxy_pass http://127.0.0.1:8214;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600;
    }

    location ^~ /@fs/ {
        proxy_pass http://127.0.0.1:8214;
        proxy_set_header Host $host;
    }

    location / {
        root /srv/codex-web/webview;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
        add_header Set-Cookie $codex_remember_cookie;
    }
}
EOF

sed -i \
  -e "s/__CODEX_TRUST_TOKEN__/${trust_token}/g" \
  -e "s/__CODEX_LISTEN_ENDPOINT__/${listen_endpoint}/g" \
  /etc/nginx/conf.d/codex-web.conf
chmod 600 /etc/nginx/conf.d/codex-web.conf
unset trust_token

nginx -t

rm -rf -- /srv/codex-web/webview.previous
if [[ -d /srv/codex-web/webview ]]; then
  mv /srv/codex-web/webview /srv/codex-web/webview.previous
fi
mv "${webview_stage}" /srv/codex-web/webview
trap - EXIT

if command -v systemctl >/dev/null 2>&1 && systemctl cat nginx >/dev/null 2>&1; then
  if systemctl is-active --quiet nginx; then
    systemctl reload nginx
  else
    systemctl start nginx
  fi
else
  nginx -s reload 2>/dev/null || nginx
fi

echo "codex-web HTTPS proxy is listening on https://${listen_endpoint}" >&2
